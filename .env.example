NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_NAME=SAMADHAN
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (packages/database) - the backend lives inside apps/web as
# Next.js Route Handlers under src/app/api/v1, not a separate service.
DATABASE_URL=postgresql://samadhan:samadhan@localhost:5432/samadhan?schema=public

# Auth (apps/web/src/server/auth) - only the short-lived access token is a
# JWT; refresh / email-verification / password-reset tokens are opaque
# random values hashed server-side.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Email (apps/web/src/server/mail) - without RESEND_API_KEY, verification and
# password-reset emails are logged to the console instead of sent, so local
# development works with no setup.
RESEND_API_KEY=
MAIL_FROM=SAMADHAN <onboarding@resend.dev>

# Supabase Storage (apps/web/src/server/storage) - backs problem media and
# project document uploads. Private buckets, short-lived signed URLs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=samadhan-media

# Supabase Realtime (apps/web/src/lib/realtime) - powers live status updates
# and notifications. The anon key is public by design (Broadcast/Presence
# channels only, no table access).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI provider (apps/web/src/server/ai) - advisory only. Without a key the
# priority engine and duplicate detection fall back to the deterministic
# rule-based implementation.
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# Maps / geocoding (apps/web/src/server/maps) - optional. Without a key the
# report form falls back to manual latitude/longitude entry.
NEXT_PUBLIC_MAPS_API_KEY=

# Upload policy
UPLOAD_MAX_SIZE_MB=15
