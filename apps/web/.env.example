# apps/web reads the same variables documented in the repo-root .env.example.
# Next.js loads .env from this directory; in development you can keep a single
# .env at the repo root and rely on the workspace scripts, or copy the needed
# keys here.

NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_NAME=SAMADHAN
NEXT_PUBLIC_APP_URL=http://localhost:3000

DATABASE_URL=postgresql://samadhan:samadhan@localhost:5432/samadhan?schema=public

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

RESEND_API_KEY=
MAIL_FROM=SAMADHAN <onboarding@resend.dev>

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=samadhan-media
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

AI_API_KEY=
AI_MODEL=claude-sonnet-5
NEXT_PUBLIC_MAPS_API_KEY=
UPLOAD_MAX_SIZE_MB=15
